{
  "name": "temple-bar-repo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import ./scripts/isolate-git-config.ts --test",
    "build": "tsc -p packages/temple-bar/tsconfig.build.json && tsc -p packages/create-temple-bar/tsconfig.build.json",
    "check": "pnpm run gate",
    "prepare": "temple-bar hook install",
    "gate": "temple-bar gate",
    "release:publish": "node scripts/release-publish.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@londontypescript/temple-bar": "0.0.8",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
