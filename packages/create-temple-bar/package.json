{
  "name": "@londontypescript/create-temple-bar",
  "version": "0.2.2",
  "description": "Sets up temple-bar, the London TypeScript workflow enforced on AI coding agents via git hooks, a quality gate and GitHub rules.",
  "keywords": [
    "typescript",
    "ai-agents",
    "coding-agents",
    "git-hooks",
    "pnpm",
    "github",
    "developer-workflow",
    "london-typescript",
    "create"
  ],
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Nnsée Nain",
    "url": "https://github.com/nnseenain"
  },
  "homepage": "https://github.com/londontypescript/temple-bar#readme",
  "bugs": {
    "url": "https://github.com/londontypescript/temple-bar/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "test": "node --test-global-setup=../../scripts/run-tests/anchor.ts --import ../../scripts/isolate-git-config.ts --import ../../scripts/isolate-temp-folder.ts --test \"src/**/*.test.ts\""
  },
  "bin": {
    "create-temple-bar": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/londontypescript/temple-bar.git",
    "directory": "packages/create-temple-bar"
  }
}
