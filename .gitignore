# Dependencies and build output
node_modules/
dist/
coverage/
*.tgz

# Env files hold secrets; their .example templates are committed.
.env
.env.*
.dev.vars
.dev.vars.*
!*.example

# OS and editor
.DS_Store
Thumbs.db

# Logs and TypeScript build info
*.log
*.tsbuildinfo

# Personal harness settings, never shared
.claude/settings.local.json
CLAUDE.local.md

# Worktrees Claude Code creates inside the repo: each is a whole checkout of
# another branch, so git and every check skip it
.claude/worktrees/

# This checkout's local working folder: drafts, and anything temple-bar or
# its agents keep for this checkout only
.temple-bar/
